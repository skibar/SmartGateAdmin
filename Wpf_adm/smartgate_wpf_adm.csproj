<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Refresh.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="wpf_adm_config.json" />
    <None Remove="wpf_amd_config.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Refresh.ico" />
    <Content Include="wpf_adm_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
  </ItemGroup>

</Project>
